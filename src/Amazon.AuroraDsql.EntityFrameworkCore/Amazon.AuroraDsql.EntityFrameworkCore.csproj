<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Amazon.AuroraDsql.EntityFrameworkCore</RootNamespace>
    <AssemblyName>Amazon.AuroraDsql.EntityFrameworkCore</AssemblyName>
    <!-- We deliberately override EF Core/Npgsql provider internals; see docs/design.md. -->
    <NoWarn>$(NoWarn);EF1001</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Amazon.AuroraDsql.EntityFrameworkCore</PackageId>
    <Version>10.0.0-preview.1</Version>
    <Authors>Oleksandr Liakhevych</Authors>
    <Description>Entity Framework Core provider for Amazon Aurora DSQL, built on Npgsql.</Description>
    <PackageTags>EntityFrameworkCore;EFCore;AuroraDSQL;Aurora;DSQL;AWS;PostgreSQL;Npgsql</PackageTags>
    <RepositoryUrl>https://github.com/Dreamescaper/Amazon.AuroraDsql.EntityFrameworkCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.AuroraDsql.Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Amazon.AuroraDsql.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="Amazon.AuroraDsql.EntityFrameworkCore.IntegrationTests" />
  </ItemGroup>

</Project>
